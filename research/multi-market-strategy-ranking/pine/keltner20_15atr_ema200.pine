//@version=6
// Python Source: research/multi-market-strategy-ranking/src/run_strategies.py (make_state)
// Ranking Strategy Name: Keltner20_1.5ATR_EMA200
// Representative Top Config: YM=F | Traditional futures | Timeframe: 1D | Exit: IS Fixed TP 0.75R / SL 1.5ATR + Strategy Exit | Sizing: Full Kelly
// TV Status: 未測 (Untested)
strategy("Keltner Channel 20 (1.5 ATR) + EMA200 Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, process_orders_on_close=false)

kelt_len    = input.int(20, title="Keltner Basis Length")
kelt_mult   = input.float(1.5, title="Keltner ATR Multiplier")
ema_len     = input.int(200, title="EMA Length")
sl_atr_mult = input.float(1.5, title="SL ATR Multiplier")
tp_r_mult   = input.float(0.75, title="TP R Multiplier")

atr_val   = ta.atr(14)
kelt_mid  = ta.ema(close, kelt_len)
kelt_up   = kelt_mid + kelt_mult * atr_val
kelt_dn   = kelt_mid - kelt_mult * atr_val
ema_val   = ta.ema(close, ema_len)

long_cond  = close > kelt_up and close > ema_val
short_cond = close < kelt_dn and close < ema_val

var float long_sl = na
var float long_tp = na
var float short_sl = na
var float short_tp = na

if long_cond
    long_sl := close - sl_atr_mult * atr_val
    long_tp := close + tp_r_mult * (sl_atr_mult * atr_val)
    strategy.entry("Long", strategy.long)

if short_cond
    short_sl := close + sl_atr_mult * atr_val
    short_tp := close - tp_r_mult * (sl_atr_mult * atr_val)
    strategy.entry("Short", strategy.short)

if strategy.position_size > 0
    strategy.exit("SL/TP Long", "Long", stop=long_sl, limit=long_tp)
    if close < kelt_mid
        strategy.close("Long")

if strategy.position_size < 0
    strategy.exit("SL/TP Short", "Short", stop=short_sl, limit=short_tp)
    if close > kelt_mid
        strategy.close("Short")
