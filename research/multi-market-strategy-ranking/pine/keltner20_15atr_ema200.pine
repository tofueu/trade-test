//@version=6
// Python Source: research/multi-market-strategy-ranking/src/run_strategies.py (make_state())
// Ranking Strategy Name: Keltner20_1.5ATR_EMA200
// Representative Top Config: YM=F | Market: Traditional futures | Timeframe: 1D | Exit: IS選定固定TP 0.75R／初始SL 1.5ATR＋策略出場 | Sizing: 全凱利 (IS Kelly: 47.216%)
// Cost Settings: Futures: $2.50/contract fee + 1 tick slippage per side
// TV Status: 未測 (Untested)
strategy("Keltner20_1.5ATR_EMA200 Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.cash_per_contract, commission_value=2.5, slippage=1, calc_on_order_fills=true, process_orders_on_close=false)

// --- Input Parameters ---
input_group_strat = "Strategy Parameters"
sl_atr_mult = input.float(1.5, title="SL ATR Multiplier", group=input_group_strat)
tp_r_mult   = input.float(0.75, title="TP R Multiplier (0 = Signal Exit Only)", group=input_group_strat)

input_group_size = "Position Sizing & Risk"
risk_pct = input.float(47.216, title="Position Risk Fraction (% of Initial Capital)", group=input_group_size)
use_risk_sizing = input.bool(true, title="Enable Fixed Initial-Capital Risk Sizing", group=input_group_size)

atr_val = ta.atr(14)
kelt_mid = ta.ema(close, 20)
kelt_up  = kelt_mid + 1.5 * atr_val
kelt_dn  = kelt_mid - 1.5 * atr_val
ema_val  = ta.ema(close, 200)

long_cond  = close > kelt_up and close > ema_val
short_cond = close < kelt_dn and close < ema_val
var float long_sl = na
var float long_tp = na
var float short_sl = na
var float short_tp = na
var bool long_state_entered = false
var bool short_state_entered = false

// Reset state flags when signal condition toggles off
if not long_cond
    long_state_entered := false
if not short_cond
    short_state_entered := false

// Allow immediate reversal entry or new position entry, preventing same-state re-entry after SL/TP
if long_cond and not long_state_entered
    dist = sl_atr_mult * atr_val
    qty_val = use_risk_sizing and dist > 0 ? (strategy.initial_capital * (risk_pct / 100.0)) / dist : na
    strategy.entry("Long", strategy.long, qty=qty_val)
    long_state_entered := true
    short_state_entered := false

if short_cond and not short_state_entered
    dist = sl_atr_mult * atr_val
    qty_val = use_risk_sizing and dist > 0 ? (strategy.initial_capital * (risk_pct / 100.0)) / dist : na
    strategy.entry("Short", strategy.short, qty=qty_val)
    short_state_entered := true
    long_state_entered := false

if ta.change(strategy.position_size) != 0
    if strategy.position_size > 0
        entry_p = strategy.opentrades.entry_price(0)
        dist = sl_atr_mult * atr_val[1]
        long_sl := entry_p - dist
        long_tp := tp_r_mult > 0 ? entry_p + tp_r_mult * dist : na
    else if strategy.position_size < 0
        entry_p = strategy.opentrades.entry_price(0)
        dist = sl_atr_mult * atr_val[1]
        short_sl := entry_p + dist
        short_tp := tp_r_mult > 0 ? entry_p - tp_r_mult * dist : na
if strategy.position_size > 0
    strategy.exit("SL/TP Long", "Long", stop=long_sl, limit=long_tp)
    if (close < kelt_mid) and not short_cond
        strategy.close("Long")

if strategy.position_size < 0
    strategy.exit("SL/TP Short", "Short", stop=short_sl, limit=short_tp)
    if (close > kelt_mid) and not long_cond
        strategy.close("Short")
