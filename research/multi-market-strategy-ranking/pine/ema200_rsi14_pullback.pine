//@version=6
// Python Source: research/multi-market-strategy-ranking/src/five_year_low_drawdown_fixed_rr.py (signals())
// Ranking Strategy Name: EMA200+RSI14_pullback
// Representative Top Config: ETHUSDT | Market: Crypto futures | Timeframe: 1D | Exit: 純固定TP 3.0R／初始SL 1.5ATR | Sizing: 全凱利 (IS Kelly: 55.257%)
// Cost Settings: Pine commission 0.10% per side approximates Python 5bps fee + 5bps price slippage; not identical.
// TV Status: 未測 (Untested)
strategy("EMA200+RSI14_pullback Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.1, slippage=0, calc_on_order_fills=true, process_orders_on_close=false)

// --- Input Parameters ---
input_group_strat = "Strategy Parameters"
sl_atr_mult = input.float(1.5, title="SL ATR Multiplier", group=input_group_strat)
tp_r_mult   = input.float(3.0, title="Fixed TP R Multiplier (0 = no fixed TP)", group=input_group_strat)
exit_mode   = input.string("Fixed RR Event", title="Python exit implementation", options=["Fixed RR Event", "Stateful Signal Exit"], group=input_group_strat)

input_group_size = "Position Sizing & Risk"
risk_pct = input.float(55.257, title="Position Risk Fraction (% of Initial Capital)", group=input_group_size)
use_risk_sizing = input.bool(true, title="Enable Fixed Initial-Capital Risk Sizing", group=input_group_size)
rsi_val = ta.rsi(close, 14)
ema_val = ta.ema(close, 200)
atr_val = ta.atr(14)

long_cond  = close > ema_val and rsi_val[1] <= 30 and rsi_val > 30
short_cond = close < ema_val and rsi_val[1] >= 70 and rsi_val < 70
var float long_sl = na
var float long_tp = na
var float short_sl = na
var float short_tp = na
var int target_state = 0

// Stateful compound Python variant: persist target until its EMA/RSI exit condition.
if exit_mode == "Stateful Signal Exit"
    if long_cond
        target_state := 1
    else if short_cond
        target_state := -1
    else if target_state == 1 and (close < ema_val or rsi_val >= 60)
        target_state := 0
    else if target_state == -1 and (close > ema_val or rsi_val <= 40)
        target_state := 0

// Fixed-RR Python variant is event-based and can re-enter only while flat.
// Compound Python variant uses persistent target-state transitions and signal exits.
long_event = exit_mode == "Fixed RR Event" and long_cond and strategy.position_size == 0
short_event = exit_mode == "Fixed RR Event" and short_cond and strategy.position_size == 0
long_state_entry = exit_mode == "Stateful Signal Exit" and target_state == 1 and ta.change(target_state) != 0
short_state_entry = exit_mode == "Stateful Signal Exit" and target_state == -1 and ta.change(target_state) != 0

if long_event or long_state_entry
    dist = sl_atr_mult * atr_val
    risk_per_contract = dist * syminfo.pointvalue
    qty_val = use_risk_sizing and risk_per_contract > 0 ? (strategy.initial_capital * (risk_pct / 100.0)) / risk_per_contract : na
    strategy.entry("Long", strategy.long, qty=qty_val)

if short_event or short_state_entry
    dist = sl_atr_mult * atr_val
    risk_per_contract = dist * syminfo.pointvalue
    qty_val = use_risk_sizing and risk_per_contract > 0 ? (strategy.initial_capital * (risk_pct / 100.0)) / risk_per_contract : na
    strategy.entry("Short", strategy.short, qty=qty_val)

if ta.change(strategy.position_size) != 0
    if strategy.position_size > 0
        entry_p = strategy.opentrades.entry_price(0)
        dist = sl_atr_mult * atr_val[1]
        long_sl := entry_p - dist
        long_tp := tp_r_mult > 0 ? entry_p + tp_r_mult * dist : na
    else if strategy.position_size < 0
        entry_p = strategy.opentrades.entry_price(0)
        dist = sl_atr_mult * atr_val[1]
        short_sl := entry_p + dist
        short_tp := tp_r_mult > 0 ? entry_p - tp_r_mult * dist : na

if strategy.position_size > 0
    strategy.exit("SL/TP Long", "Long", stop=long_sl, limit=long_tp)
    if exit_mode == "Stateful Signal Exit" and (close < ema_val or rsi_val >= 60)
        strategy.close("Long")

if strategy.position_size < 0
    strategy.exit("SL/TP Short", "Short", stop=short_sl, limit=short_tp)
    if exit_mode == "Stateful Signal Exit" and (close > ema_val or rsi_val <= 40)
        strategy.close("Short")
