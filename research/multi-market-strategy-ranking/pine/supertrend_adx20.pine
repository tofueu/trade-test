//@version=6
// Python Source: research/multi-market-strategy-ranking/src/run_strategies.py (make_state())
// Ranking Strategy Name: Supertrend_ADX20
// Representative Top Config: DOGEUSDT | Market: Crypto futures | Timeframe: 1D | Exit: IS選定固定TP 0.75R／初始SL 1.5ATR＋策略出場 | Sizing: 全凱利 (IS Kelly: 40.554%)
// Cost Settings: Crypto: 0.10% total per side (5 bps fee + 5 bps slippage)
// TV Status: 未測 (Untested)
strategy("Supertrend_ADX20 Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.1, slippage=0, calc_on_order_fills=true, process_orders_on_close=false)

// --- Input Parameters ---
input_group_strat = "Strategy Parameters"
sl_atr_mult = input.float(1.5, title="SL ATR Multiplier", group=input_group_strat)
tp_r_mult   = input.float(0.75, title="TP R Multiplier (0 = Signal Exit Only)", group=input_group_strat)

input_group_size = "Position Sizing & Risk"
risk_pct = input.float(40.554, title="Position Risk Fraction (% of Initial Capital)", group=input_group_size)
use_risk_sizing = input.bool(true, title="Enable Fixed Initial-Capital Risk Sizing", group=input_group_size)

[st_val, st_dir] = ta.supertrend(3.0, 10)
[_, _, adx_val]  = ta.dmi(14, 14)
atr_val  = ta.atr(14)

st_bull = st_dir < 0
st_bear = st_dir > 0

long_cond  = st_bull and ta.change(st_dir) and adx_val > 20
short_cond = st_bear and ta.change(st_dir) and adx_val > 20
var float long_sl = na
var float long_tp = na
var float short_sl = na
var float short_tp = na
var int target_state = 0
var int last_entered_target_state = 0

// Update target state based on signal conditions
if long_cond
    target_state := 1
else if short_cond
    target_state := -1
else
    target_state := 0

// Gate entries by target-state transition to match Python backtest loop, preserving same-next-open reversals
if target_state == 1 and target_state != last_entered_target_state
    dist = sl_atr_mult * atr_val
    // Adjust risk per contract using syminfo.pointvalue for futures contract sizing parity
    risk_per_contract = dist * syminfo.pointvalue
    qty_val = use_risk_sizing and risk_per_contract > 0 ? (strategy.initial_capital * (risk_pct / 100.0)) / risk_per_contract : na
    strategy.entry("Long", strategy.long, qty=qty_val)
    last_entered_target_state := 1

if target_state == -1 and target_state != last_entered_target_state
    dist = sl_atr_mult * atr_val
    risk_per_contract = dist * syminfo.pointvalue
    qty_val = use_risk_sizing and risk_per_contract > 0 ? (strategy.initial_capital * (risk_pct / 100.0)) / risk_per_contract : na
    strategy.entry("Short", strategy.short, qty=qty_val)
    last_entered_target_state := -1

if ta.change(strategy.position_size) != 0
    if strategy.position_size > 0
        entry_p = strategy.opentrades.entry_price(0)
        dist = sl_atr_mult * atr_val[1]
        long_sl := entry_p - dist
        long_tp := tp_r_mult > 0 ? entry_p + tp_r_mult * dist : na
    else if strategy.position_size < 0
        entry_p = strategy.opentrades.entry_price(0)
        dist = sl_atr_mult * atr_val[1]
        short_sl := entry_p + dist
        short_tp := tp_r_mult > 0 ? entry_p - tp_r_mult * dist : na
if strategy.position_size > 0
    strategy.exit("SL/TP Long", "Long", stop=long_sl, limit=long_tp)
    if st_bear
        strategy.close("Long")

if strategy.position_size < 0
    strategy.exit("SL/TP Short", "Short", stop=short_sl, limit=short_tp)
    if st_bull
        strategy.close("Short")
