//@version=6
// Python Source: research/multi-market-strategy-ranking/src/five_year_low_drawdown_fixed_rr.py (signals())
// Ranking Strategy Name: Stoch14+EMA200
// Representative Top Config: GC=F | Market: Traditional futures | Timeframe: 1D | Exit: 純固定TP 2.0R／初始SL 1.5ATR | Sizing: 全凱利 (IS Kelly: 39.919%)
// Cost Settings: Futures: $2.50 / contract fee + 1 tick slippage per side
// TV Status: 未測 (Untested)
strategy("Stoch14+EMA200 Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.cash_per_contract, commission_value=2.5, slippage=1, process_orders_on_close=false)

// --- Input Parameters ---
input_group_strat = "Strategy Parameters"
sl_atr_mult = input.float(1.5, title="SL ATR Multiplier", group=input_group_strat, tooltip="Initial SL distance in ATR multiples (Python default 1.5 ATR)")
tp_r_mult   = input.float(2.0, title="TP R Multiplier (0 = Signal Exit)", group=input_group_strat)

input_group_size = "Position Sizing & Risk"
risk_pct = input.float(39.919, title="Position Risk Fraction (% of Equity)", group=input_group_size, tooltip="Python R-based sizing risk fraction (e.g. 39.919% for IS Kelly top row, 10% for Fixed 1R)")
use_risk_sizing = input.bool(true, title="Enable Python Risk-based Sizing (R-based)", group=input_group_size, tooltip="Sizes contracts/units so total trade loss equals risk_pct of equity")

stoch_k   = input.int(14, title="Stoch %K Length")
stoch_smooth = input.int(3, title="Stoch Smooth K")
ema_len   = input.int(200, title="EMA Length")

stoch_val = ta.sma(ta.stoch(close, high, low, stoch_k), stoch_smooth)
ema_val   = ta.ema(close, ema_len)
atr_val   = ta.atr(14)

long_cond  = close > ema_val and ta.crossover(stoch_val, 20)
short_cond = close < ema_val and ta.crossunder(stoch_val, 80)

var float long_sl = na
var float long_tp = na
var float short_sl = na
var float short_tp = na

if long_cond
    dist = sl_atr_mult * atr_val
    qty_val = use_risk_sizing and dist > 0 ? (strategy.equity * (risk_pct / 100.0)) / dist : na
    strategy.entry("Long", strategy.long, qty=qty_val)

if short_cond
    dist = sl_atr_mult * atr_val
    qty_val = use_risk_sizing and dist > 0 ? (strategy.equity * (risk_pct / 100.0)) / dist : na
    strategy.entry("Short", strategy.short, qty=qty_val)

if ta.change(strategy.position_size) != 0
    if strategy.position_size > 0
        entry_p = strategy.opentrades.entry_price(0)
        sig_atr = atr_val[1]
        dist = sl_atr_mult * sig_atr
        long_sl := entry_p - dist
        long_tp := entry_p + tp_r_mult * dist
    else if strategy.position_size < 0
        entry_p = strategy.opentrades.entry_price(0)
        sig_atr = atr_val[1]
        dist = sl_atr_mult * sig_atr
        short_sl := entry_p + dist
        short_tp := entry_p - tp_r_mult * dist

if strategy.position_size > 0
    strategy.exit("SL/TP Long", "Long", stop=long_sl, limit=long_tp)

if strategy.position_size < 0
    strategy.exit("SL/TP Short", "Short", stop=short_sl, limit=short_tp)
