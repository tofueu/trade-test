//@version=6
// Python Source: research/multi-market-strategy-ranking/src/five_year_low_drawdown_fixed_rr.py (signals())
// Ranking Strategy Name: Stoch14+EMA200
// Representative Top Config: GC=F | Market: Traditional futures | Timeframe: 1D | Exit: 純固定TP 2.0R／初始SL 1.5ATR | Sizing: 全凱利 (IS Kelly: 39.919%)
// Cost Settings: Futures: $2.50/contract fee + 1 tick slippage per side
// TV Status: 未測 (Untested)
strategy("Stoch14+EMA200 Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.cash_per_contract, commission_value=2.5, slippage=1, calc_on_order_fills=true, process_orders_on_close=false)

// --- Input Parameters ---
input_group_strat = "Strategy Parameters"
sl_atr_mult = input.float(1.5, title="SL ATR Multiplier", group=input_group_strat)
tp_r_mult   = input.float(2.0, title="TP R Multiplier (0 = Signal Exit)", group=input_group_strat)

input_group_size = "Position Sizing & Risk"
risk_pct = input.float(39.919, title="Position Risk Fraction (% of Initial Capital)", group=input_group_size)
use_risk_sizing = input.bool(true, title="Enable Fixed Initial-Capital Risk Sizing", group=input_group_size)

stoch_val = ta.sma(ta.stoch(close, high, low, 14), 3)
ema_val   = ta.ema(close, 200)
atr_val   = ta.atr(14)

long_cond  = close > ema_val and ta.crossover(stoch_val, 20)
short_cond = close < ema_val and ta.crossunder(stoch_val, 80)

var float long_sl = na
var float long_tp = na
var float short_sl = na
var float short_tp = na

if long_cond
    dist = sl_atr_mult * atr_val
    qty_val = use_risk_sizing and dist > 0 ? (strategy.initial_capital * (risk_pct / 100.0)) / dist : na
    strategy.entry("Long", strategy.long, qty=qty_val)

if short_cond
    dist = sl_atr_mult * atr_val
    qty_val = use_risk_sizing and dist > 0 ? (strategy.initial_capital * (risk_pct / 100.0)) / dist : na
    strategy.entry("Short", strategy.short, qty=qty_val)

if ta.change(strategy.position_size) != 0
    if strategy.position_size > 0
        entry_p = strategy.opentrades.entry_price(0)
        dist = sl_atr_mult * atr_val[1]
        long_sl := entry_p - dist
        long_tp := entry_p + tp_r_mult * dist
    else if strategy.position_size < 0
        entry_p = strategy.opentrades.entry_price(0)
        dist = sl_atr_mult * atr_val[1]
        short_sl := entry_p + dist
        short_tp := entry_p - tp_r_mult * dist

if strategy.position_size > 0
    strategy.exit("SL/TP Long", "Long", stop=long_sl, limit=long_tp)

if strategy.position_size < 0
    strategy.exit("SL/TP Short", "Short", stop=short_sl, limit=short_tp)
