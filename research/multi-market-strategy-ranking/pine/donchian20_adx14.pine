//@version=6
// Python Source: research/multi-market-strategy-ranking/src/five_year_low_drawdown_fixed_rr.py (signals)
// Ranking Strategy Name: Donchian20+ADX14
// Representative Top Config: SOLUSDT | Crypto futures | Timeframe: 1D | Exit: Pure Fixed TP 1.5R / SL 1.5ATR | Sizing: Full Kelly
// TV Status: 未測 (Untested)
strategy("Donchian 20 + ADX 14 Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, process_orders_on_close=false)

donch_len   = input.int(20, title="Donchian Channel Length")
adx_len     = input.int(14, title="ADX Length")
adx_thresh  = input.float(20.0, title="ADX Threshold")
sl_atr_mult = input.float(1.5, title="SL ATR Multiplier")
tp_r_mult   = input.float(1.5, title="TP R Multiplier")

hi20 = ta.highest(high[1], donch_len)
lo20 = ta.lowest(low[1], donch_len)
[_, _, adx_val] = ta.dmi(adx_len, adx_len)
atr_val = ta.atr(14)

long_cond  = close > hi20 and adx_val > adx_thresh
short_cond = close < lo20 and adx_val > adx_thresh

var float long_sl = na
var float long_tp = na
var float short_sl = na
var float short_tp = na

if long_cond
    long_sl := close - sl_atr_mult * atr_val
    long_tp := close + tp_r_mult * (sl_atr_mult * atr_val)
    strategy.entry("Long", strategy.long)

if short_cond
    short_sl := close + sl_atr_mult * atr_val
    short_tp := close - tp_r_mult * (sl_atr_mult * atr_val)
    strategy.entry("Short", strategy.short)

if strategy.position_size > 0
    strategy.exit("SL/TP Long", "Long", stop=long_sl, limit=long_tp)

if strategy.position_size < 0
    strategy.exit("SL/TP Short", "Short", stop=short_sl, limit=short_tp)
