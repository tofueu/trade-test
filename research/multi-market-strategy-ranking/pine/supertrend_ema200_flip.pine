//@version=6
// Python Source: research/multi-market-strategy-ranking/src/five_year_low_drawdown_fixed_rr.py (signals())
// Ranking Strategy Name: Supertrend+EMA200_flip
// Representative Top Config: NQ=F | Market: Traditional futures | Timeframe: 1D | Exit: 純固定TP 3.0R／初始SL 1.5ATR | Sizing: 全凱利 (IS Kelly: 44.43%)
// Cost Settings: Futures: $2.50/contract fee + 1 tick slippage per side
// TV Status: 未測 (Untested)
strategy("Supertrend+EMA200_flip Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.cash_per_contract, commission_value=2.5, slippage=1, calc_on_order_fills=false, process_orders_on_close=false)

// --- Input Parameters ---
input_group_strat = "Strategy Parameters"
sl_atr_mult = input.float(1.5, title="SL ATR Multiplier", group=input_group_strat)
tp_r_mult   = input.float(3.0, title="TP R Multiplier (0 = Signal Exit Only)", group=input_group_strat)

input_group_size = "Position Sizing & Risk"
risk_pct = input.float(44.43, title="Position Risk Fraction (% of Initial Capital)", group=input_group_size)
use_risk_sizing = input.bool(true, title="Enable Fixed Initial-Capital Risk Sizing", group=input_group_size)
[st_val, st_dir] = ta.supertrend(3.0, 10)
ema_val = ta.ema(close, 200)
atr_val = ta.atr(14)

st_bull = st_dir < 0
st_bear = st_dir > 0

long_cond  = st_bull and st_dir[1] > 0 and close > ema_val
short_cond = st_bear and st_dir[1] < 0 and close < ema_val
var float long_sl = na
var float long_tp = na
var float short_sl = na
var float short_tp = na

// Pure Fixed-RR Event Entry Gating: Requires flat position to trigger new event
if long_cond and strategy.position_size == 0
    dist = sl_atr_mult * atr_val
    risk_per_contract = dist * syminfo.pointvalue
    qty_val = use_risk_sizing and risk_per_contract > 0 ? (strategy.initial_capital * (risk_pct / 100.0)) / risk_per_contract : na
    long_sl_armed = close - sl_atr_mult * atr_val
    long_tp_armed = tp_r_mult > 0 ? close + tp_r_mult * (sl_atr_mult * atr_val) : na
    strategy.entry("Long", strategy.long, qty=qty_val)
    strategy.exit("SL/TP Long", "Long", stop=long_sl_armed, limit=long_tp_armed)

if short_cond and strategy.position_size == 0
    dist = sl_atr_mult * atr_val
    risk_per_contract = dist * syminfo.pointvalue
    qty_val = use_risk_sizing and risk_per_contract > 0 ? (strategy.initial_capital * (risk_pct / 100.0)) / risk_per_contract : na
    short_sl_armed = close + sl_atr_mult * atr_val
    short_tp_armed = tp_r_mult > 0 ? close - tp_r_mult * (sl_atr_mult * atr_val) : na
    strategy.entry("Short", strategy.short, qty=qty_val)
    strategy.exit("SL/TP Short", "Short", stop=short_sl_armed, limit=short_tp_armed)

if ta.change(strategy.position_size) != 0
    if strategy.position_size > 0
        entry_p = strategy.opentrades.entry_price(0)
        dist = sl_atr_mult * atr_val[1]
        long_sl := entry_p - dist
        long_tp := tp_r_mult > 0 ? entry_p + tp_r_mult * dist : na
    else if strategy.position_size < 0
        entry_p = strategy.opentrades.entry_price(0)
        dist = sl_atr_mult * atr_val[1]
        short_sl := entry_p + dist
        short_tp := tp_r_mult > 0 ? entry_p - tp_r_mult * dist : na

if strategy.position_size > 0
    strategy.exit("SL/TP Long", "Long", stop=long_sl, limit=long_tp)

if strategy.position_size < 0
    strategy.exit("SL/TP Short", "Short", stop=short_sl, limit=short_tp)
