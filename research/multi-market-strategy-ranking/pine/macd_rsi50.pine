//@version=6
// Python Source: research/multi-market-strategy-ranking/src/five_year_compound_strategy_sweep.py (custom_signals())
// Ranking Strategy Name: MACD+RSI50
// Representative Top Config: XRPUSDT | Market: Crypto futures | Timeframe: 1D | Exit: 訊號出場(無固定TP) | Sizing: 全凱利 (IS Kelly: 10.519%)
// Cost Settings: Crypto: 0.10% total per side (5 bps fee + 5 bps slippage)
// TV Status: 未測 (Untested)
strategy("MACD+RSI50 Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.1, slippage=0, calc_on_order_fills=true, process_orders_on_close=false)

// --- Input Parameters ---
input_group_strat = "Strategy Parameters"
sl_atr_mult = input.float(1.5, title="SL ATR Multiplier", group=input_group_strat)
tp_r_mult   = input.float(0.0, title="TP R Multiplier (0 = Signal Exit Only)", group=input_group_strat)

input_group_size = "Position Sizing & Risk"
risk_pct = input.float(10.519, title="Position Risk Fraction (% of Initial Capital)", group=input_group_size)
use_risk_sizing = input.bool(true, title="Enable Fixed Initial-Capital Risk Sizing", group=input_group_size)

[macd_line, sig_line, _] = ta.macd(close, 12, 26, 9)
rsi_val = ta.rsi(close, 14)
atr_val = ta.atr(14)

long_cond  = macd_line > sig_line and rsi_val > 50
short_cond = macd_line < sig_line and rsi_val < 50
var float long_sl = na
var float long_tp = na
var float short_sl = na
var float short_tp = na

// State transition entry gating matching Python side == 0 rule
long_entry_trigger  = long_cond and not long_cond[1] and strategy.position_size == 0
short_entry_trigger = short_cond and not short_cond[1] and strategy.position_size == 0

if long_entry_trigger
    dist = sl_atr_mult * atr_val
    qty_val = use_risk_sizing and dist > 0 ? (strategy.initial_capital * (risk_pct / 100.0)) / dist : na
    strategy.entry("Long", strategy.long, qty=qty_val)

if short_entry_trigger
    dist = sl_atr_mult * atr_val
    qty_val = use_risk_sizing and dist > 0 ? (strategy.initial_capital * (risk_pct / 100.0)) / dist : na
    strategy.entry("Short", strategy.short, qty=qty_val)

if ta.change(strategy.position_size) != 0
    if strategy.position_size > 0
        entry_p = strategy.opentrades.entry_price(0)
        dist = sl_atr_mult * atr_val[1]
        long_sl := entry_p - dist
        long_tp := tp_r_mult > 0 ? entry_p + tp_r_mult * dist : na
    else if strategy.position_size < 0
        entry_p = strategy.opentrades.entry_price(0)
        dist = sl_atr_mult * atr_val[1]
        short_sl := entry_p + dist
        short_tp := tp_r_mult > 0 ? entry_p - tp_r_mult * dist : na
if strategy.position_size > 0
    strategy.exit("SL Long", "Long", stop=long_sl)
    if macd_line < sig_line or rsi_val <= 50
        strategy.close("Long")

if strategy.position_size < 0
    strategy.exit("SL Short", "Short", stop=short_sl)
    if macd_line > sig_line or rsi_val >= 50
        strategy.close("Short")
