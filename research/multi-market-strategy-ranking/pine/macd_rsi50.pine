//@version=6
// Python Source: research/multi-market-strategy-ranking/src/five_year_compound_strategy_sweep.py (custom_signals)
// Ranking Strategy Name: MACD+RSI50
// Representative Top Config: XRPUSDT | Crypto futures | Timeframe: 1D | Exit: Signal Exit (No Fixed TP) | Sizing: Full Kelly
// TV Status: 未測 (Untested)
strategy("MACD + RSI50 Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, process_orders_on_close=false)

fast_len = input.int(12, title="MACD Fast Length")
slow_len = input.int(26, title="MACD Slow Length")
sig_len  = input.int(9, title="MACD Signal Length")
rsi_len  = input.int(14, title="RSI Length")
sl_atr_mult = input.float(1.5, title="SL ATR Multiplier")

[macd_line, sig_line, _] = ta.macd(close, fast_len, slow_len, sig_len)
rsi_val = ta.rsi(close, rsi_len)
atr_val = ta.atr(14)

long_cond  = ta.crossover(macd_line, sig_line) and rsi_val > 50
short_cond = ta.crossunder(macd_line, sig_line) and rsi_val < 50

var float long_sl = na
var float short_sl = na

if long_cond
    long_sl := close - sl_atr_mult * atr_val
    strategy.entry("Long", strategy.long)

if short_cond
    short_sl := close + sl_atr_mult * atr_val
    strategy.entry("Short", strategy.short)

if strategy.position_size > 0
    strategy.exit("SL Long", "Long", stop=long_sl)
    if ta.crossunder(macd_line, sig_line) or rsi_val <= 50
        strategy.close("Long")

if strategy.position_size < 0
    strategy.exit("SL Short", "Short", stop=short_sl)
    if ta.crossover(macd_line, sig_line) or rsi_val >= 50
        strategy.close("Short")
