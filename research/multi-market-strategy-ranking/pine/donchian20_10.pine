//@version=6
// Python Source: research/multi-market-strategy-ranking/src/five_year_multi_market_kelly.py (make_signals)
// Ranking Strategy Name: Donchian20_10
// Representative Top Config: SOLUSDT | Crypto futures | Timeframe: 1D | Exit: Fixed 1R + Signal Exit | Sizing: Full Kelly
// TV Status: 未測 (Untested)
strategy("Donchian 20/10 Breakout Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, process_orders_on_close=false)

entry_len   = input.int(20, title="Entry Channel Length")
exit_len    = input.int(10, title="Exit Channel Length")
sl_atr_mult = input.float(1.5, title="SL ATR Multiplier")
tp_r_mult   = input.float(1.0, title="TP R Multiplier")

hi_entry = ta.highest(high[1], entry_len)
lo_entry = ta.lowest(low[1], entry_len)
hi_exit  = ta.highest(high[1], exit_len)
lo_exit  = ta.lowest(low[1], exit_len)
atr_val  = ta.atr(14)

long_cond  = close > hi_entry
short_cond = close < lo_entry

var float long_sl = na
var float long_tp = na
var float short_sl = na
var float short_tp = na

if long_cond
    long_sl := close - sl_atr_mult * atr_val
    long_tp := close + tp_r_mult * (sl_atr_mult * atr_val)
    strategy.entry("Long", strategy.long)

if short_cond
    short_sl := close + sl_atr_mult * atr_val
    short_tp := close - tp_r_mult * (sl_atr_mult * atr_val)
    strategy.entry("Short", strategy.short)

if strategy.position_size > 0
    strategy.exit("SL/TP Long", "Long", stop=long_sl, limit=long_tp)
    if close < lo_exit
        strategy.close("Long")

if strategy.position_size < 0
    strategy.exit("SL/TP Short", "Short", stop=short_sl, limit=short_tp)
    if close > hi_exit
        strategy.close("Short")
