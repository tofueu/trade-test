//@version=6
// Python Source: research/multi-market-strategy-ranking/src/run_strategies.py (make_state)
// Ranking Strategy Name: Donchian20_Volume_EMA200
// Representative Top Config: GC=F | Traditional futures | Timeframe: 1D | Exit: IS Fixed TP 1R / SL 1.5ATR + Strategy Exit | Sizing: Full Kelly
// TV Status: 未測 (Untested)
strategy("Donchian 20 + Volume + EMA200 Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, process_orders_on_close=false)

entry_len   = input.int(20, title="Entry Channel Length")
exit_len    = input.int(10, title="Exit Channel Length")
vol_len     = input.int(20, title="Volume SMA Length")
vol_mult    = input.float(1.5, title="Volume Multiplier")
ema_len     = input.int(200, title="EMA Length")
sl_atr_mult = input.float(1.5, title="SL ATR Multiplier")
tp_r_mult   = input.float(1.0, title="TP R Multiplier")

hi20 = ta.highest(high[1], entry_len)
lo20 = ta.lowest(low[1], entry_len)
hi10 = ta.highest(high[1], exit_len)
lo10 = ta.lowest(low[1], exit_len)
vol_sma = ta.sma(volume, vol_len)
ema_val = ta.ema(close, ema_len)
atr_val = ta.atr(14)

vol_ok = volume > vol_mult * vol_sma

long_cond  = close > hi20 and vol_ok and close > ema_val
short_cond = close < lo20 and vol_ok and close < ema_val

var float long_sl = na
var float long_tp = na
var float short_sl = na
var float short_tp = na

if long_cond
    long_sl := close - sl_atr_mult * atr_val
    long_tp := close + tp_r_mult * (sl_atr_mult * atr_val)
    strategy.entry("Long", strategy.long)

if short_cond
    short_sl := close + sl_atr_mult * atr_val
    short_tp := close - tp_r_mult * (sl_atr_mult * atr_val)
    strategy.entry("Short", strategy.short)

if strategy.position_size > 0
    strategy.exit("SL/TP Long", "Long", stop=long_sl, limit=long_tp)
    if close < lo10
        strategy.close("Long")

if strategy.position_size < 0
    strategy.exit("SL/TP Short", "Short", stop=short_sl, limit=short_tp)
    if close > hi10
        strategy.close("Short")
