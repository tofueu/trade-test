//@version=6
// Python Source: research/multi-market-strategy-ranking/src/five_year_low_drawdown_fixed_rr.py (signals)
// Ranking Strategy Name: Bollinger20+RSI14_reentry
// Representative Top Config: DOGEUSDT | Crypto futures | Timeframe: 1D | Exit: Pure Fixed TP 3.0R / SL 1.5ATR | Sizing: Full Kelly
// TV Status: 未測 (Untested)
strategy("Bollinger Band Re-entry + RSI14 Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, process_orders_on_close=false)

bb_len      = input.int(20, title="Bollinger Length")
bb_mult     = input.float(2.0, title="Bollinger StdDev Multiplier")
rsi_len     = input.int(14, title="RSI Length")
sl_atr_mult = input.float(1.5, title="SL ATR Multiplier")
tp_r_mult   = input.float(3.0, title="TP R Multiplier")

[bb_mid, bb_up, bb_dn] = ta.bb(close, bb_len, bb_mult)
rsi_val = ta.rsi(close, rsi_len)
atr_val = ta.atr(14)

long_cond  = close[1] <= bb_dn[1] and close > bb_dn and rsi_val < 45
short_cond = close[1] >= bb_up[1] and close < bb_up and rsi_val > 55

var float long_sl = na
var float long_tp = na
var float short_sl = na
var float short_tp = na

if long_cond
    long_sl := close - sl_atr_mult * atr_val
    long_tp := close + tp_r_mult * (sl_atr_mult * atr_val)
    strategy.entry("Long", strategy.long)

if short_cond
    short_sl := close + sl_atr_mult * atr_val
    short_tp := close - tp_r_mult * (sl_atr_mult * atr_val)
    strategy.entry("Short", strategy.short)

if strategy.position_size > 0
    strategy.exit("SL/TP Long", "Long", stop=long_sl, limit=long_tp)
    if close >= bb_mid
        strategy.close("Long")

if strategy.position_size < 0
    strategy.exit("SL/TP Short", "Short", stop=short_sl, limit=short_tp)
    if close <= bb_mid
        strategy.close("Short")
