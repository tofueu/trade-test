//@version=6
// Python Source: research/multi-market-strategy-ranking/src/five_year_multi_market_kelly.py (make_signals())
// Ranking Strategy Name: Bollinger20_2
// Representative Top Config: SI=F | Market: Traditional futures | Timeframe: 1D | Exit: ATR移動止盈2x+訊號出場 | Sizing: 全凱利 (IS Kelly: 19.134%)
// Cost Settings: Futures: $2.50/contract fee + 1 tick slippage per side
// TV Status: 未測 (Untested)
strategy("Bollinger20_2 Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.cash_per_contract, commission_value=2.5, slippage=1, calc_on_order_fills=false, process_orders_on_close=false)

// --- Input Parameters ---
input_group_strat = "Strategy Parameters"
sl_atr_mult = input.float(1.5, title="SL ATR Multiplier", group=input_group_strat)
tp_r_mult   = input.float(0.0, title="TP R Multiplier (0 = Signal Exit Only)", group=input_group_strat)

input_group_size = "Position Sizing & Risk"
risk_pct = input.float(19.134, title="Position Risk Fraction (% of Initial Capital)", group=input_group_size)
use_risk_sizing = input.bool(true, title="Enable Fixed Initial-Capital Risk Sizing", group=input_group_size)

[bb_mid, bb_up, bb_dn] = ta.bb(close, 20, 2.0)
atr_val = ta.atr(14)

long_cond  = close[1] <= bb_dn[1] and close > bb_dn
short_cond = close[1] >= bb_up[1] and close < bb_up

var float long_sl = na
var float short_sl = na
var int target_state = 0

if long_cond
    target_state := 1
else if short_cond
    target_state := -1
else if target_state == 1 and close >= bb_mid
    target_state := 0
else if target_state == -1 and close <= bb_mid
    target_state := 0

if target_state == 1 and ta.change(target_state) != 0
    dist = sl_atr_mult * atr_val
    risk_per_contract = dist * syminfo.pointvalue
    qty_val = use_risk_sizing and risk_per_contract > 0 ? (strategy.initial_capital * (risk_pct / 100.0)) / risk_per_contract : na
    long_stop_ticks = int(math.round(dist / syminfo.mintick))
    long_profit_ticks = tp_r_mult > 0 ? int(math.round(tp_r_mult * dist / syminfo.mintick)) : na
    strategy.entry("Long", strategy.long, qty=qty_val)
    strategy.exit("SL/TP Long", "Long", loss=long_stop_ticks, profit=long_profit_ticks)

if target_state == -1 and ta.change(target_state) != 0
    dist = sl_atr_mult * atr_val
    risk_per_contract = dist * syminfo.pointvalue
    qty_val = use_risk_sizing and risk_per_contract > 0 ? (strategy.initial_capital * (risk_pct / 100.0)) / risk_per_contract : na
    short_stop_ticks = int(math.round(dist / syminfo.mintick))
    short_profit_ticks = tp_r_mult > 0 ? int(math.round(tp_r_mult * dist / syminfo.mintick)) : na
    strategy.entry("Short", strategy.short, qty=qty_val)
    strategy.exit("SL/TP Short", "Short", loss=short_stop_ticks, profit=short_profit_ticks)

if ta.change(strategy.position_size) != 0
    if strategy.position_size > 0
        entry_p = strategy.opentrades.entry_price(0)
        long_sl := entry_p - sl_atr_mult * atr_val[1]
    else if strategy.position_size < 0
        entry_p = strategy.opentrades.entry_price(0)
        short_sl := entry_p + sl_atr_mult * atr_val[1]
if strategy.position_size > 0
    if close >= bb_mid or short_cond
        strategy.cancel("SL/TP Long")
        strategy.close("Long")
    else
        strategy.exit("SL/TP Long", "Long", stop=long_sl, limit=long_tp)

if strategy.position_size < 0
    if close <= bb_mid or long_cond
        strategy.cancel("SL/TP Short")
        strategy.close("Short")
    else
        strategy.exit("SL/TP Short", "Short", stop=short_sl, limit=short_tp)
