//@version=6
// Python Source: research/multi-market-strategy-ranking/src/five_year_multi_market_kelly.py (make_signals)
// Ranking Strategy Name: Bollinger20_2
// Representative Top Config: SI=F | Traditional futures | Timeframe: 1D | Exit: ATR Trailing TP 2x + Signal Exit | Sizing: Full Kelly
// TV Status: 未測 (Untested)
strategy("Bollinger Bands 20/2 Breakout Re-entry Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, process_orders_on_close=false)

bb_len      = input.int(20, title="Bollinger Length")
bb_mult     = input.float(2.0, title="Bollinger StdDev Multiplier")
sl_atr_mult = input.float(1.5, title="SL ATR Multiplier")

[bb_mid, bb_up, bb_dn] = ta.bb(close, bb_len, bb_mult)
atr_val = ta.atr(14)

long_cond  = close[1] <= bb_dn[1] and close > bb_dn
short_cond = close[1] >= bb_up[1] and close < bb_up

var float long_sl = na
var float short_sl = na

if long_cond
    long_sl := close - sl_atr_mult * atr_val
    strategy.entry("Long", strategy.long)

if short_cond
    short_sl := close + sl_atr_mult * atr_val
    strategy.entry("Short", strategy.short)

if strategy.position_size > 0
    strategy.exit("SL Long", "Long", stop=long_sl)
    if close >= bb_mid
        strategy.close("Long")

if strategy.position_size < 0
    strategy.exit("SL Short", "Short", stop=short_sl)
    if close <= bb_mid
        strategy.close("Short")
