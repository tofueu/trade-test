//@version=6
// Python Source: research/multi-market-strategy-ranking/src/five_year_multi_market_kelly.py (make_signals(), market_backtest())
// Ranking Strategy Name: MACD12_26_9
// Representative Top Config: XRPUSDT | Market: Crypto futures | Timeframe: 1D | Exit: 訊號出場(無固定TP) | Sizing: 全凱利 (IS Kelly: 20.067%)
// Signal timeframe input: blank follows chart; a selected timeframe must be equal to or an integer multiple of the chart timeframe.
// Cost Settings: Pine commission 0.10% per side approximates Python 5bps fee + 5bps price slippage; not identical.
// TV Status: 未測 (Untested)\n// Timeframe sizing: daily 20.067%; 4H 10.0335%; other timeframes use input default 20.067%.
strategy("MACD12_26_9 Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.1, slippage=0, calc_on_order_fills=false, process_orders_on_close=false)

// --- Input Parameters ---
input_group_strat = "Strategy Parameters"
signal_timeframe = input.timeframe("", title="Signal timeframe (blank = chart timeframe)", group=input_group_strat, tooltip="Leave blank to use the chart timeframe. A selected timeframe must be equal to or an integer multiple of the chart timeframe. Lower-timeframe signals require the chart to use that timeframe.")
sl_atr_mult = input.float(1.5, title="SL ATR Multiplier", group=input_group_strat)
tp_r_mult   = input.float(0.0, title="TP R Multiplier (0 = Signal Exit Only)", group=input_group_strat)

input_group_size = "Position Sizing & Risk"
daily_risk_pct = input.float(20.067, title="Daily Risk % of Initial Capital", group=input_group_size)
// 4H uses a slower MACD to reduce intraday noise; daily and other timeframes keep 12/26/9.
h4_risk_pct = input.float(20.0, title="4H Risk % of Initial Capital", group=input_group_size)
other_risk_pct = input.float(20.067, title="Other Timeframes Risk % of Initial Capital", group=input_group_size)
risk_pct = timeframe.period == "240" ? h4_risk_pct : timeframe.isdaily ? daily_risk_pct : other_risk_pct
use_risk_sizing = input.bool(true, title="Enable Fixed Initial-Capital Risk Sizing", group=input_group_size)

// Validate the selected signal timeframe. Lower-timeframe requests are intentionally rejected,
// and higher-timeframe selections must align with chart bars to avoid silently missing signals.
chart_tf_seconds = timeframe.in_seconds()
signal_tf = signal_timeframe == "" ? timeframe.period : signal_timeframe
signal_tf_seconds = timeframe.in_seconds(signal_tf)
if na(chart_tf_seconds) or na(signal_tf_seconds)
    runtime.error("Use a time-based chart and a valid signal timeframe.")
if signal_tf_seconds < chart_tf_seconds
    runtime.error("Signal timeframe must be equal to or higher than the chart timeframe.")
if signal_tf_seconds % chart_tf_seconds != 0
    runtime.error("Signal timeframe must be an integer multiple of the chart timeframe.")

// The chart-timeframe signals preserve the original strategy's same-bar-close detection.
fast_len = timeframe.period == "240" ? 24 : 12
slow_len = timeframe.period == "240" ? 52 : 26
sig_len = timeframe.period == "240" ? 18 : 9
[macd_chart, signal_chart, _] = ta.macd(close, fast_len, slow_len, sig_len)
long_chart_signal = ta.crossover(macd_chart, signal_chart)
short_chart_signal = ta.crossunder(macd_chart, signal_chart)
atr_chart = ta.atr(14)

// For a selected higher timeframe, use only the last completed signal/ATR bar.
// lookahead_on + [1] keeps historical and realtime values consistent (no developing-HTF repaint).
f_confirmed_signal_data() =>
    [macd_htf, signal_htf, _] = ta.macd(close, fast_len, slow_len, sig_len)
    [ta.crossover(macd_htf, signal_htf)[1], ta.crossunder(macd_htf, signal_htf)[1], ta.atr(14)[1]]

[long_htf_signal, short_htf_signal, atr_htf] = request.security(
    syminfo.tickerid, signal_tf, f_confirmed_signal_data(),
    gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

use_higher_signal_tf = signal_tf_seconds > chart_tf_seconds
// On a lower chart timeframe, act once at the first chart-bar close after the higher
// timeframe candle is confirmed; market orders still fill on the next chart-bar open.
new_signal_period = timeframe.change(signal_tf)
long_cond = use_higher_signal_tf ? (new_signal_period and long_htf_signal) : long_chart_signal
short_cond = use_higher_signal_tf ? (new_signal_period and short_htf_signal) : short_chart_signal
atr_val = use_higher_signal_tf ? atr_htf : atr_chart

var float long_sl = na
var float long_tp = na
var float short_sl = na
var float short_tp = na
var int target_state = 0

if long_cond
    target_state := 1
else if short_cond
    target_state := -1

if target_state == 1 and ta.change(target_state) != 0
    dist = sl_atr_mult * atr_val
    risk_per_contract = dist * syminfo.pointvalue
    qty_val = use_risk_sizing and risk_per_contract > 0 ? (strategy.initial_capital * (risk_pct / 100.0)) / risk_per_contract : na
    long_stop_ticks = int(math.round(dist / syminfo.mintick))
    long_profit_ticks = tp_r_mult > 0 ? int(math.round(tp_r_mult * dist / syminfo.mintick)) : na
    strategy.entry("Long", strategy.long, qty=qty_val)
    strategy.exit("SL/TP Long", "Long", loss=long_stop_ticks, profit=long_profit_ticks)

if target_state == -1 and ta.change(target_state) != 0
    dist = sl_atr_mult * atr_val
    risk_per_contract = dist * syminfo.pointvalue
    qty_val = use_risk_sizing and risk_per_contract > 0 ? (strategy.initial_capital * (risk_pct / 100.0)) / risk_per_contract : na
    short_stop_ticks = int(math.round(dist / syminfo.mintick))
    short_profit_ticks = tp_r_mult > 0 ? int(math.round(tp_r_mult * dist / syminfo.mintick)) : na
    strategy.entry("Short", strategy.short, qty=qty_val)
    strategy.exit("SL/TP Short", "Short", loss=short_stop_ticks, profit=short_profit_ticks)

if ta.change(strategy.position_size) != 0
    if strategy.position_size > 0
        entry_p = strategy.opentrades.entry_price(0)
        dist = sl_atr_mult * atr_val[1]
        long_sl := entry_p - dist
        long_tp := tp_r_mult > 0 ? entry_p + tp_r_mult * dist : na
    else if strategy.position_size < 0
        entry_p = strategy.opentrades.entry_price(0)
        dist = sl_atr_mult * atr_val[1]
        short_sl := entry_p + dist
        short_tp := tp_r_mult > 0 ? entry_p - tp_r_mult * dist : na

// Python market_backtest() applies an opposite target at the next open before testing
// the old position's stop. Cancel that protective order on the signal bar so a gap
// through the stop cannot outrank the already-known signal exit/reversal.
if strategy.position_size > 0
    if short_cond
        strategy.cancel("SL/TP Long")
    else
        strategy.exit("SL/TP Long", "Long", stop=long_sl, limit=long_tp)

if strategy.position_size < 0
    if long_cond
        strategy.cancel("SL/TP Short")
    else
        strategy.exit("SL/TP Short", "Short", stop=short_sl, limit=short_tp)
