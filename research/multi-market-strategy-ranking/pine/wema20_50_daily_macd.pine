//@version=6
// Python Source: research/multi-market-strategy-ranking/src/five_year_low_drawdown_fixed_rr.py (signals())
// Ranking Strategy Name: WEMA20_50+DailyMACD
// Representative Top Config: SOLUSDT | Market: Crypto futures | Timeframe: 1D | Exit: 純固定TP 3.0R／初始SL 1.5ATR | Sizing: 全凱利 (IS Kelly: 19.659%)
// Cost Settings: Crypto: 0.10% total per side (5 bps fee + 5 bps slippage)
// TV Status: 未測 (Untested)
strategy("WEMA20_50+DailyMACD Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.1, slippage=0, calc_on_order_fills=true, process_orders_on_close=false)

// --- Input Parameters ---
input_group_strat = "Strategy Parameters"
sl_atr_mult = input.float(1.5, title="SL ATR Multiplier", group=input_group_strat)
tp_r_mult   = input.float(3.0, title="TP R Multiplier (0 = Signal Exit Only)", group=input_group_strat)

input_group_size = "Position Sizing & Risk"
risk_pct = input.float(19.659, title="Position Risk Fraction (% of Initial Capital)", group=input_group_size)
use_risk_sizing = input.bool(true, title="Enable Fixed Initial-Capital Risk Sizing", group=input_group_size)

w_ema20 = request.security(syminfo.tickerid, "W", ta.ema(close, 20), barmerge.gaps_off, barmerge.lookahead_off)
w_ema50 = request.security(syminfo.tickerid, "W", ta.ema(close, 50), barmerge.gaps_off, barmerge.lookahead_off)

[macd_line, sig_line, _] = ta.macd(close, 12, 26, 9)
atr_val = ta.atr(14)

long_cond  = w_ema20 > w_ema50 and ta.crossover(macd_line, sig_line)
short_cond = w_ema20 < w_ema50 and ta.crossunder(macd_line, sig_line)

var float long_sl = na
var float long_tp = na
var float short_sl = na
var float short_tp = na

if long_cond
    dist = sl_atr_mult * atr_val
    qty_val = use_risk_sizing and dist > 0 ? (strategy.initial_capital * (risk_pct / 100.0)) / dist : na
    strategy.entry("Long", strategy.long, qty=qty_val)

if short_cond
    dist = sl_atr_mult * atr_val
    qty_val = use_risk_sizing and dist > 0 ? (strategy.initial_capital * (risk_pct / 100.0)) / dist : na
    strategy.entry("Short", strategy.short, qty=qty_val)

if ta.change(strategy.position_size) != 0
    if strategy.position_size > 0
        entry_p = strategy.opentrades.entry_price(0)
        dist = sl_atr_mult * atr_val[1]
        long_sl := entry_p - dist
        long_tp := tp_r_mult > 0 ? entry_p + tp_r_mult * dist : na
    else if strategy.position_size < 0
        entry_p = strategy.opentrades.entry_price(0)
        dist = sl_atr_mult * atr_val[1]
        short_sl := entry_p + dist
        short_tp := tp_r_mult > 0 ? entry_p - tp_r_mult * dist : na

if strategy.position_size > 0
    strategy.exit("SL/TP Long", "Long", stop=long_sl, limit=long_tp)

if strategy.position_size < 0
    strategy.exit("SL/TP Short", "Short", stop=short_sl, limit=short_tp)
