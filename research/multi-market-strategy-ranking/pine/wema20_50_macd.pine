//@version=6
// Python Source: research/multi-market-strategy-ranking/src/five_year_compound_strategy_sweep.py (custom_signals())
// Ranking Strategy Name: WEMA20_50+MACD
// Representative Top Config: SI=F | Market: Traditional futures | Timeframe: 1D | Exit: ATR移動止盈2x+訊號出場 | Sizing: 全凱利 (IS Kelly: 26.521%)
// Cost Settings: Futures: $2.50/contract fee + 1 tick slippage per side
// TV Status: 未測 (Untested)
strategy("WEMA20_50+MACD Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.cash_per_contract, commission_value=2.5, slippage=1, calc_on_order_fills=true, process_orders_on_close=false)

// --- Input Parameters ---
input_group_strat = "Strategy Parameters"
sl_atr_mult = input.float(1.5, title="SL ATR Multiplier", group=input_group_strat)
tp_r_mult   = input.float(0.0, title="TP R Multiplier (0 = Signal Exit Only)", group=input_group_strat)

input_group_size = "Position Sizing & Risk"
risk_pct = input.float(26.521, title="Position Risk Fraction (% of Initial Capital)", group=input_group_size)
use_risk_sizing = input.bool(true, title="Enable Fixed Initial-Capital Risk Sizing", group=input_group_size)

w_ema20 = request.security(syminfo.tickerid, "W", ta.ema(close, 20)[1], barmerge.gaps_off, barmerge.lookahead_on)
w_ema50 = request.security(syminfo.tickerid, "W", ta.ema(close, 50)[1], barmerge.gaps_off, barmerge.lookahead_on)
[macd_line, sig_line, _] = ta.macd(close, 12, 26, 9)
atr_val = ta.atr(14)

long_cond  = w_ema20 > w_ema50 and ta.crossover(macd_line, sig_line)
short_cond = w_ema20 < w_ema50 and ta.crossunder(macd_line, sig_line)
var float long_sl = na
var float long_tp = na
var float short_sl = na
var float short_tp = na
var int target_state = 0

// Update target state based on signal conditions
if long_cond
    target_state := 1
else if short_cond
    target_state := -1
else if target_state == 1 and (w_ema20 <= w_ema50 or macd_line < sig_line)
    target_state := 0
else if target_state == -1 and (w_ema20 >= w_ema50 or macd_line > sig_line)
    target_state := 0

// Gate entries by target-state transition to match Python backtest loop, preserving same-next-open reversals
if target_state == 1 and ta.change(target_state) != 0
    dist = sl_atr_mult * atr_val
    // Adjust risk per contract using syminfo.pointvalue for futures contract sizing parity
    risk_per_contract = dist * syminfo.pointvalue
    qty_val = use_risk_sizing and risk_per_contract > 0 ? (strategy.initial_capital * (risk_pct / 100.0)) / risk_per_contract : na
    strategy.entry("Long", strategy.long, qty=qty_val)

if target_state == -1 and ta.change(target_state) != 0
    dist = sl_atr_mult * atr_val
    risk_per_contract = dist * syminfo.pointvalue
    qty_val = use_risk_sizing and risk_per_contract > 0 ? (strategy.initial_capital * (risk_pct / 100.0)) / risk_per_contract : na
    strategy.entry("Short", strategy.short, qty=qty_val)

if ta.change(strategy.position_size) != 0
    if strategy.position_size > 0
        entry_p = strategy.opentrades.entry_price(0)
        dist = sl_atr_mult * atr_val[1]
        long_sl := entry_p - dist
        long_tp := tp_r_mult > 0 ? entry_p + tp_r_mult * dist : na
    else if strategy.position_size < 0
        entry_p = strategy.opentrades.entry_price(0)
        dist = sl_atr_mult * atr_val[1]
        short_sl := entry_p + dist
        short_tp := tp_r_mult > 0 ? entry_p - tp_r_mult * dist : na
if strategy.position_size > 0
    strategy.exit("SL Long", "Long", stop=long_sl)
    if target_state == 0 and (macd_line < sig_line or w_ema20 <= w_ema50)
        strategy.close("Long")

if strategy.position_size < 0
    strategy.exit("SL Short", "Short", stop=short_sl)
    if target_state == 0 and (macd_line > sig_line or w_ema20 >= w_ema50)
        strategy.close("Short")
