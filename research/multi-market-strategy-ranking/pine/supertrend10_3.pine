//@version=6
// Python Source: research/multi-market-strategy-ranking/src/five_year_multi_market_kelly.py (make_signals())
// Ranking Strategy Name: Supertrend10_3
// Representative Top Config: SOLUSDT | Market: Crypto futures | Timeframe: 1D | Exit: 訊號出場(無固定TP) | Sizing: 全凱利 (IS Kelly: 24.544%)
// Cost Settings: Crypto: 0.10% total per side (5 bps fee + 5 bps slippage)
// TV Status: 未測 (Untested)
strategy("Supertrend10_3 Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.1, slippage=0, calc_on_order_fills=true, process_orders_on_close=false)

// --- Input Parameters ---
input_group_strat = "Strategy Parameters"
sl_atr_mult = input.float(1.5, title="SL ATR Multiplier", group=input_group_strat)
tp_r_mult   = input.float(0.0, title="TP R Multiplier (0 = Signal Exit Only)", group=input_group_strat)

input_group_size = "Position Sizing & Risk"
risk_pct = input.float(24.544, title="Position Risk Fraction (% of Initial Capital)", group=input_group_size)
use_risk_sizing = input.bool(true, title="Enable Fixed Initial-Capital Risk Sizing", group=input_group_size)

[st_val, st_dir] = ta.supertrend(3.0, 10)
atr_val = ta.atr(14)

st_bull = st_dir < 0
st_bear = st_dir > 0

long_cond  = st_bull and ta.change(st_dir)
short_cond = st_bear and ta.change(st_dir)

var float long_sl = na
var float long_tp = na
var float short_sl = na
var float short_tp = na

if long_cond
    dist = sl_atr_mult * atr_val
    qty_val = use_risk_sizing and dist > 0 ? (strategy.initial_capital * (risk_pct / 100.0)) / dist : na
    strategy.entry("Long", strategy.long, qty=qty_val)

if short_cond
    dist = sl_atr_mult * atr_val
    qty_val = use_risk_sizing and dist > 0 ? (strategy.initial_capital * (risk_pct / 100.0)) / dist : na
    strategy.entry("Short", strategy.short, qty=qty_val)

if ta.change(strategy.position_size) != 0
    if strategy.position_size > 0
        entry_p = strategy.opentrades.entry_price(0)
        dist = sl_atr_mult * atr_val[1]
        long_sl := entry_p - dist
        long_tp := tp_r_mult > 0 ? entry_p + tp_r_mult * dist : na
    else if strategy.position_size < 0
        entry_p = strategy.opentrades.entry_price(0)
        dist = sl_atr_mult * atr_val[1]
        short_sl := entry_p + dist
        short_tp := tp_r_mult > 0 ? entry_p - tp_r_mult * dist : na

if strategy.position_size > 0
    strategy.exit("SL Long", "Long", stop=long_sl)
    if st_bear
        strategy.close("Long")

if strategy.position_size < 0
    strategy.exit("SL Short", "Short", stop=short_sl)
    if st_bull
        strategy.close("Short")
