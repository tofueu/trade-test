//@version=6
// Python Source: research/multi-market-strategy-ranking/src/five_year_compound_strategy_sweep.py (custom_signals)
// Ranking Strategy Name: WEMA20_50+Donchian20
// Representative Top Config: NQ=F | Traditional futures | Timeframe: 1D | Exit: Fixed 4R + Signal Exit | Sizing: Full Kelly
// TV Status: 未測 (Untested)
strategy("Weekly EMA 20/50 + Daily Donchian 20 Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, process_orders_on_close=false)

donch_len   = input.int(20, title="Donchian Channel Length")
sl_atr_mult = input.float(1.5, title="SL ATR Multiplier")
tp_r_mult   = input.float(4.0, title="TP R Multiplier")

w_ema20 = request.security(syminfo.tickerid, "W", ta.ema(close, 20), barmerge.gaps_off, barmerge.lookahead_off)
w_ema50 = request.security(syminfo.tickerid, "W", ta.ema(close, 50), barmerge.gaps_off, barmerge.lookahead_off)

hi20 = ta.highest(high[1], donch_len)
lo20 = ta.lowest(low[1], donch_len)
atr_val = ta.atr(14)

long_cond  = w_ema20 > w_ema50 and close > hi20
short_cond = w_ema20 < w_ema50 and close < lo20

var float long_sl = na
var float long_tp = na
var float short_sl = na
var float short_tp = na

if long_cond
    long_sl := close - sl_atr_mult * atr_val
    long_tp := close + tp_r_mult * (sl_atr_mult * atr_val)
    strategy.entry("Long", strategy.long)

if short_cond
    short_sl := close + sl_atr_mult * atr_val
    short_tp := close - tp_r_mult * (sl_atr_mult * atr_val)
    strategy.entry("Short", strategy.short)

if strategy.position_size > 0
    strategy.exit("SL/TP Long", "Long", stop=long_sl, limit=long_tp)
    if close < lo20 or w_ema20 < w_ema50
        strategy.close("Long")

if strategy.position_size < 0
    strategy.exit("SL/TP Short", "Short", stop=short_sl, limit=short_tp)
    if close > hi20 or w_ema20 > w_ema50
        strategy.close("Short")
