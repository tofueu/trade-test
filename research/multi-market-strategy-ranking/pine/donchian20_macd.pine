//@version=6
// Python Source: research/multi-market-strategy-ranking/src/five_year_compound_strategy_sweep.py (custom_signals())
// Ranking Strategy Name: Donchian20+MACD
// Representative Top Config: DOGEUSDT | Market: Crypto futures | Timeframe: 1D | Exit: 訊號出場(無固定TP) | Sizing: 全凱利 (IS Kelly: 21.555%)
// Cost Settings: Pine commission 0.10% per side approximates Python 5bps fee + 5bps price slippage; not identical.
// TV Status: 未測 (Untested)
strategy("Donchian20+MACD Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.1, slippage=0, calc_on_order_fills=true, process_orders_on_close=false)

// --- Input Parameters ---
input_group_strat = "Strategy Parameters"
sl_atr_mult = input.float(1.5, title="SL ATR Multiplier", group=input_group_strat)
tp_r_mult   = input.float(0.0, title="TP R Multiplier (0 = Signal Exit Only)", group=input_group_strat)

input_group_size = "Position Sizing & Risk"
risk_pct = input.float(21.555, title="Position Risk Fraction (% of Initial Capital)", group=input_group_size)
use_risk_sizing = input.bool(true, title="Enable Fixed Initial-Capital Risk Sizing", group=input_group_size)

hi20 = ta.highest(high[1], 20)
lo20 = ta.lowest(low[1], 20)
hi10 = ta.highest(high[1], 10)
lo10 = ta.lowest(low[1], 10)
[macd_line, sig_line, _] = ta.macd(close, 12, 26, 9)
atr_val = ta.atr(14)

long_cond  = close > hi20 and macd_line > sig_line
short_cond = close < lo20 and macd_line < sig_line

var float long_sl = na
var float short_sl = na
var int target_state = 0

if long_cond
    target_state := 1
else if short_cond
    target_state := -1
else if target_state == 1 and (close < lo10 or macd_line < sig_line)
    target_state := 0
else if target_state == -1 and (close > hi10 or macd_line > sig_line)
    target_state := 0

if target_state == 1 and ta.change(target_state) != 0
    dist = sl_atr_mult * atr_val
    risk_per_contract = dist * syminfo.pointvalue
    qty_val = use_risk_sizing and risk_per_contract > 0 ? (strategy.initial_capital * (risk_pct / 100.0)) / risk_per_contract : na
    strategy.entry("Long", strategy.long, qty=qty_val)

if target_state == -1 and ta.change(target_state) != 0
    dist = sl_atr_mult * atr_val
    risk_per_contract = dist * syminfo.pointvalue
    qty_val = use_risk_sizing and risk_per_contract > 0 ? (strategy.initial_capital * (risk_pct / 100.0)) / risk_per_contract : na
    strategy.entry("Short", strategy.short, qty=qty_val)

if ta.change(strategy.position_size) != 0
    if strategy.position_size > 0
        entry_p = strategy.opentrades.entry_price(0)
        long_sl := entry_p - sl_atr_mult * atr_val[1]
    else if strategy.position_size < 0
        entry_p = strategy.opentrades.entry_price(0)
        short_sl := entry_p + sl_atr_mult * atr_val[1]

if strategy.position_size > 0
    strategy.exit("SL Long", "Long", stop=long_sl)
    if target_state == 0 and (close < lo10 or macd_line < sig_line)
        strategy.close("Long")

if strategy.position_size < 0
    strategy.exit("SL Short", "Short", stop=short_sl)
    if target_state == 0 and (close > hi10 or macd_line > sig_line)
        strategy.close("Short")
