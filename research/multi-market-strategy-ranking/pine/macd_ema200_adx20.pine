//@version=6
// Python Source: research/multi-market-strategy-ranking/src/run_strategies.py (make_state())
// Ranking Strategy Name: MACD_EMA200_ADX20
// Representative Top Config: BTCUSDT | Market: Crypto futures | Timeframe: 1D | Exit: IS選定固定TP 3R／初始SL 1.5ATR＋策略出場 | Sizing: 全凱利 (IS Kelly: 15.091%)
// Cost Settings: Pine commission 0.10% per side approximates Python 5bps fee + 5bps price slippage; not identical.
// TV Status: 未測 (Untested)
strategy("MACD_EMA200_ADX20 Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.1, slippage=0, calc_on_order_fills=false, process_orders_on_close=false)

// --- Input Parameters ---
input_group_strat = "Strategy Parameters"
sl_atr_mult = input.float(1.5, title="SL ATR Multiplier", group=input_group_strat)
tp_r_mult   = input.float(3.0, title="TP R Multiplier (0 = Signal Exit Only)", group=input_group_strat)

input_group_size = "Position Sizing & Risk"
risk_pct = input.float(15.091, title="Position Risk Fraction (% of Initial Capital)", group=input_group_size)
use_risk_sizing = input.bool(true, title="Enable Fixed Initial-Capital Risk Sizing", group=input_group_size)

[macd_line, sig_line, _] = ta.macd(close, 12, 26, 9)
ema_val = ta.ema(close, 200)
[_, _, adx_val] = ta.dmi(14, 14)
atr_val = ta.atr(14)

long_cond  = adx_val > 20 and ta.crossover(macd_line, sig_line) and close > ema_val
short_cond = adx_val > 20 and ta.crossunder(macd_line, sig_line) and close < ema_val

var float long_sl = na
var float long_tp = na
var float short_sl = na
var float short_tp = na
var int target_state = 0

if long_cond
    target_state := 1
else if short_cond
    target_state := -1
else if target_state == 1 and (ta.crossunder(macd_line, sig_line) or close < ema_val)
    target_state := 0
else if target_state == -1 and (ta.crossover(macd_line, sig_line) or close > ema_val)
    target_state := 0

if target_state == 1 and ta.change(target_state) != 0
    dist = sl_atr_mult * atr_val
    risk_per_contract = dist * syminfo.pointvalue
    qty_val = use_risk_sizing and risk_per_contract > 0 ? (strategy.initial_capital * (risk_pct / 100.0)) / risk_per_contract : na
    long_sl_armed = close - sl_atr_mult * atr_val
    long_tp_armed = tp_r_mult > 0 ? close + tp_r_mult * (sl_atr_mult * atr_val) : na
    strategy.entry("Long", strategy.long, qty=qty_val)
    strategy.exit("SL/TP Long", "Long", stop=long_sl_armed, limit=long_tp_armed)

if target_state == -1 and ta.change(target_state) != 0
    dist = sl_atr_mult * atr_val
    risk_per_contract = dist * syminfo.pointvalue
    qty_val = use_risk_sizing and risk_per_contract > 0 ? (strategy.initial_capital * (risk_pct / 100.0)) / risk_per_contract : na
    short_sl_armed = close + sl_atr_mult * atr_val
    short_tp_armed = tp_r_mult > 0 ? close - tp_r_mult * (sl_atr_mult * atr_val) : na
    strategy.entry("Short", strategy.short, qty=qty_val)
    strategy.exit("SL/TP Short", "Short", stop=short_sl_armed, limit=short_tp_armed)

if ta.change(strategy.position_size) != 0
    if strategy.position_size > 0
        entry_p = strategy.opentrades.entry_price(0)
        dist = sl_atr_mult * atr_val[1]
        long_sl := entry_p - dist
        long_tp := tp_r_mult > 0 ? entry_p + tp_r_mult * dist : na
    else if strategy.position_size < 0
        entry_p = strategy.opentrades.entry_price(0)
        dist = sl_atr_mult * atr_val[1]
        short_sl := entry_p + dist
        short_tp := tp_r_mult > 0 ? entry_p - tp_r_mult * dist : na
if strategy.position_size > 0
    if ta.crossunder(macd_line, sig_line) or close < ema_val or short_cond
        strategy.cancel("SL/TP Long")
        strategy.close("Long")
    else
        strategy.exit("SL/TP Long", "Long", stop=long_sl, limit=long_tp)

if strategy.position_size < 0
    if ta.crossover(macd_line, sig_line) or close > ema_val or long_cond
        strategy.cancel("SL/TP Short")
        strategy.close("Short")
    else
        strategy.exit("SL/TP Short", "Short", stop=short_sl, limit=short_tp)
