//@version=6
// Port of existing Python rank 1 EMA50_200 / signal exit (no TP).
// Saved rank 1 configuration: SOLUSDT, 3h, IS Kelly 13.67442526787219%.
// Sources: five_year_multi_market_kelly.py indicators()/make_signals(),
// five_year_exit_method_sweep.py backtest(). No trade end date.
// Python price-relative slippage 0.05%/side is not modeled by zero tick slippage.
// 2026-11-26: original Python replay reproduced all 85 saved trades.
// This Pine still requires TradingView compilation/fill/performance verification.
// Python has no notional-margin simulation; margin=0 reproduces that research assumption,
// NOT a realistic exchange leverage or liquidation model.
// Benchmark interval: 2021-10-10 <= entry < 2026-10-10 UTC. No expiry here;
// later trades change the total, so compare using the SAME ending date.
strategy("R01 | EMA50_200 | Python rank configuration", overlay=true,
     initial_capital=10000, currency=currency.USD,
     commission_type=strategy.commission.percent, commission_value=0.05,
     slippage=0, pyramiding=0, margin_long=0, margin_short=0,
     process_orders_on_close=false, calc_on_order_fills=false,
     default_qty_type=strategy.fixed)

// Source manifest warm-up and comparison start; neither is an expiry.
warmTime = timestamp("01 Sep 2021 00:00 +0000")
tradeStart = timestamp("10 Oct 2021 00:00 +0000")
riskFraction = 13.67442526787219 / 100.0
atrMultiplier = 1.5
reset = time >= warmTime and (na(time[1]) or time[1] < warmTime)
var bool fullSourceWarmup = false
if reset
    fullSourceWarmup := time == warmTime

f_ewm(float source, float alpha, bool doReset) =>
    var float value = na
    if doReset
        value := source
    else if time >= warmTime and not na(source)
        value := na(value) ? source : value == source ? value : (1.0 - alpha) * value + alpha * source
    value

ema50 = f_ewm(close, 2.0 / 51.0, reset)
ema200 = f_ewm(close, 2.0 / 201.0, reset)
trValue = reset ? high - low : ta.tr(true)
atrRaw = f_ewm(trValue, 1.0 / 14.0, reset)
var int warmBars = 0
if reset
    warmBars := 1
else if time >= warmTime
    warmBars += 1
atr14 = warmBars >= 14 ? atrRaw : na

// Python holds the last EMA crossover state until the opposite crossover.
var int signalState = 0
if time >= warmTime
    if ema50 > ema200 and ema50[1] <= ema200[1]
        signalState := 1
    else if ema50 < ema200 and ema50[1] >= ema200[1]
        signalState := -1

canTrade = time_close >= tradeStart and warmBars >= 250 and not na(atr14)
startTransition = canTrade and not canTrade[1]
previousSignal = nz(signalState[1], 0)
newSide = signalState != 0 and (signalState != previousSignal or startTransition)
riskCash = strategy.initial_capital * riskFraction
var bool capitalHalted = false
if strategy.initial_capital + strategy.netprofit < riskCash
    capitalHalted := true

if barstate.isconfirmed and canTrade
    if strategy.position_size > 0 and signalState != 1
        strategy.cancel("Long SL")
        if signalState == 0
            strategy.close("Long", comment="Signal exit")
    if strategy.position_size < 0 and signalState != -1
        strategy.cancel("Short SL")
        if signalState == 0
            strategy.close("Short", comment="Signal exit")
    if newSide and atr14 > 0 and not capitalHalted
        distance = atrMultiplier * atr14
        quantity = riskCash / (distance * syminfo.pointvalue)
        stopTicks = int(math.max(1, math.round(distance / syminfo.mintick)))
        if signalState == 1
            strategy.entry("Long", strategy.long, qty=quantity, comment="EMA50_200")
            strategy.exit("Long SL", from_entry="Long", loss=stopTicks)
        else
            strategy.entry("Short", strategy.short, qty=quantity, comment="EMA50_200")
            strategy.exit("Short SL", from_entry="Short", loss=stopTicks)

plot(ema50, "Python EWM EMA50", color=color.orange)
plot(ema200, "Python EWM EMA200", color=color.blue)

// Display a warning only when the original warm-up start is absent.
// This does not filter or manufacture signals on shorter loaded histories.
var table historyNotice = table.new(position.top_right, 1, 1)
if barstate.islast
    table.cell(historyNotice, 0, 0, fullSourceWarmup ? "" : "Loaded history lacks 2021-09-01 warm-up; rank parity unverified", text_color=color.orange)
