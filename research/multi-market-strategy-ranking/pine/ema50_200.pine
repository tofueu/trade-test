//@version=6
// Python Source: research/multi-market-strategy-ranking/src/five_year_multi_market_kelly.py (make_signals)
// Ranking Strategy Name: EMA50_200
// Representative Top Config: BTCUSDT | Crypto futures | Timeframe: 1D | Exit: Signal Exit (No Fixed TP) | Sizing: Fixed 1R
// TV Status: 未測 (Untested)
strategy("EMA 50/200 Golden/Death Cross Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, process_orders_on_close=false)

ema_fast_len = input.int(50, title="Fast EMA Length")
ema_slow_len = input.int(200, title="Slow EMA Length")
sl_atr_mult  = input.float(1.5, title="SL ATR Multiplier")

ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
atr_val  = ta.atr(14)

long_cond  = ta.crossover(ema_fast, ema_slow)
short_cond = ta.crossunder(ema_fast, ema_slow)

var float long_sl = na
var float short_sl = na

if long_cond
    long_sl := close - sl_atr_mult * atr_val
    strategy.entry("Long", strategy.long)

if short_cond
    short_sl := close + sl_atr_mult * atr_val
    strategy.entry("Short", strategy.short)

if strategy.position_size > 0
    strategy.exit("SL Long", "Long", stop=long_sl)
    if ta.crossunder(ema_fast, ema_slow)
        strategy.close("Long")

if strategy.position_size < 0
    strategy.exit("SL Short", "Short", stop=short_sl)
    if ta.crossover(ema_fast, ema_slow)
        strategy.close("Short")
