//@version=6
// Python Source: research/multi-market-strategy-ranking/src/run_strategies.py (make_state)
// Ranking Strategy Name: Turtle55_20_EMA200
// Representative Top Config: ETHUSDT | Crypto futures | Timeframe: 1D | Exit: IS Fixed TP 1.5R / SL 1.5ATR + Strategy Exit | Sizing: Full Kelly
// TV Status: 未測 (Untested)
strategy("Turtle 55/20 + EMA200 Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, process_orders_on_close=false)

entry_len   = input.int(55, title="Turtle Entry Channel Length")
exit_len    = input.int(20, title="Turtle Exit Channel Length")
ema_len     = input.int(200, title="EMA Length")
sl_atr_mult = input.float(1.5, title="SL ATR Multiplier")
tp_r_mult   = input.float(1.5, title="TP R Multiplier")

hi55 = ta.highest(high[1], entry_len)
lo55 = ta.lowest(low[1], entry_len)
hi20 = ta.highest(high[1], exit_len)
lo20 = ta.lowest(low[1], exit_len)
ema_val = ta.ema(close, ema_len)
atr_val = ta.atr(14)

long_cond  = close > hi55 and close > ema_val
short_cond = close < lo55 and close < ema_val

var float long_sl = na
var float long_tp = na
var float short_sl = na
var float short_tp = na

if long_cond
    long_sl := close - sl_atr_mult * atr_val
    long_tp := close + tp_r_mult * (sl_atr_mult * atr_val)
    strategy.entry("Long", strategy.long)

if short_cond
    short_sl := close + sl_atr_mult * atr_val
    short_tp := close - tp_r_mult * (sl_atr_mult * atr_val)
    strategy.entry("Short", strategy.short)

if strategy.position_size > 0
    strategy.exit("SL/TP Long", "Long", stop=long_sl, limit=long_tp)
    if close < lo20
        strategy.close("Long")

if strategy.position_size < 0
    strategy.exit("SL/TP Short", "Short", stop=short_sl, limit=short_tp)
    if close > hi20
        strategy.close("Short")
