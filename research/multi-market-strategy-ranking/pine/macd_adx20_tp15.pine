//@version=6
// Ranking Strategy Name: MACD_ADX20
// TV Status: TV_UNVERIFIED
// Notes: Created for >=70 trades candidate testing

strategy("MACD_ADX20", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

ema12 = ta.ema(close, 12)
ema26 = ta.ema(close, 26)
macd = ema12 - ema26
macdsig = ta.ema(macd, 9)
[diplus, diminus, adx] = ta.dmi(14, 14)
atr14 = ta.atr(14)

longCondition = macd > macdsig and adx > 20
if (longCondition)
    strategy.entry("Long", strategy.long)
    stopLevel = close - 1.5 * atr14
    takeLevel = close + 1.5 * atr14
    strategy.exit("Exit Long", "Long", stop=stopLevel, limit=takeLevel)

shortCondition = macd < macdsig and adx > 20
if (shortCondition)
    strategy.entry("Short", strategy.short)
    stopLevel = close + 1.5 * atr14
    takeLevel = close - 1.5 * atr14
    strategy.exit("Exit Short", "Short", stop=stopLevel, limit=takeLevel)
