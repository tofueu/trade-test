//@version=6
// Rank 2 port of Python five_year_compound_strategy_sweep.py + five_year_exit_method_sweep.py.
// Market/data: Binance USD-M SOLUSDT daily -> BINANCE:SOLUSDT.P, 1D.
// Python window: 2021-10-10 <= UTC bar time < 2026-10-10; warm-up begins 2021-07-01.
// Costs: Python 5 bp fee + 5 bp adverse slippage per side. TV fee matches; TV slip is ticks.
// Signals match Python custom_signals(): when neither aligned condition holds, the signal state is reset to zero.
strategy("R02 | SOLUSDT | Supertrend+RSI50 | signal exit | full Kelly",
     overlay=true, initial_capital=10000, currency=currency.USD,
     commission_type=strategy.commission.percent, commission_value=0.05,
     slippage=0, margin_long=1, margin_short=1, pyramiding=0,
     process_orders_on_close=false, calc_on_order_fills=false,
     default_qty_type=strategy.fixed, default_qty_value=1)

startTime = input.time(timestamp("10 Oct 2021 00:00 +0000"), "Test start (UTC)")
warmTime = timestamp("01 Jul 2021 00:00 +0000")
kellyPct = input.float(20.07779203610597, "IS Kelly risk % of initial capital", step=0.000001) / 100.0
atrMult = input.float(1.5, "Initial stop ATR multiple", step=0.1)

// Exact pandas-style recursive EWM seed at the first source warm-up bar.
f_ewm(float src, float alpha, bool reset) =>
    var float value = na
    if reset
        value := src
    else if not na(src)
        value := na(value) ? src : alpha * src + (1.0 - alpha) * value
    value

warmReset = time == warmTime
trValue = warmReset ? high - low : ta.tr(true)
atr14Raw = f_ewm(trValue, 1.0 / 14.0, warmReset)
atr10Raw = f_ewm(trValue, 0.1, warmReset)
var int atr14Bars = 0
var int atr10Bars = 0
if warmReset
    atr14Bars := 1
    atr10Bars := 1
else if time > warmTime
    atr14Bars += 1
    atr10Bars += 1
atr14 = atr14Bars >= 14 ? atr14Raw : na
atr10 = atr10Bars >= 10 ? atr10Raw : na

// Python RSI14 also uses adjust=False EWM with 14 non-NA deltas as warm-up.
delta = time > warmTime ? close - close[1] : na
gain = not na(delta) ? math.max(delta, 0.0) : na
loss = not na(delta) ? math.max(-delta, 0.0) : na
avgGain = f_ewm(gain, 1.0 / 14.0, warmReset)
avgLoss = f_ewm(loss, 1.0 / 14.0, warmReset)
var int rsiSamples = 0
if warmReset
    rsiSamples := 0
else if time > warmTime
    rsiSamples += 1
rsi14 = rsiSamples >= 14 ? (avgLoss == 0 ? (avgGain == 0 ? 50.0 : 100.0) : 100.0 - 100.0 / (1.0 + avgGain / avgLoss)) : na

// Recreate Python ATR10 Supertrend (midpoint +/- 3*ATR, recursively clamped bands).
basicUpper = (high + low) / 2.0 + 3.0 * atr10
basicLower = (high + low) / 2.0 - 3.0 * atr10
var float finalUpper = na
var float finalLower = na
var int stDirection = 0
if not na(atr10)
    if na(finalUpper[1])
        finalUpper := basicUpper
        finalLower := basicLower
        stDirection := 1
    else
        finalUpper := (basicUpper < finalUpper[1] or close[1] > finalUpper[1]) ? basicUpper : finalUpper[1]
        finalLower := (basicLower > finalLower[1] or close[1] < finalLower[1]) ? basicLower : finalLower[1]
        prevDirection = nz(stDirection[1], 1)
        stDirection := prevDirection < 0 and close > finalUpper ? 1 : prevDirection > 0 and close < finalLower ? -1 : prevDirection

// Match custom_signals() state machine literally: hold state in the unqualified zone.
var int signalState = 0
if not na(rsi14) and stDirection != 0
    signalState := stDirection > 0 and rsi14 > 50 ? 1 : stDirection < 0 and rsi14 < 50 ? -1 : 0

previousSignalState = nz(signalState[1], 0)
startTransition = time >= startTime and time[1] < startTime
inWindow = time >= startTime
newLong = signalState == 1 and (previousSignalState != 1 or startTransition)
newShort = signalState == -1 and (previousSignalState != -1 or startTransition)
// Python exit_method_sweep.py: close at the next bar open whenever the prior signal is no longer the held side.
if inWindow and barstate.isconfirmed
    if strategy.position_size > 0 and signalState != 1
        strategy.close("Long", comment="Signal exit")
    if strategy.position_size < 0 and signalState != -1
        strategy.close("Short", comment="Signal exit")

// Signal is confirmed at the daily close; Python enters/reverses at the next daily open.
// Opposite signal exit has priority over that next bar's stop, so cancel the old stop now.
if inWindow and barstate.isconfirmed and not na(atr14) and atr14 > 0
    stopDistance = atrMult * atr14
    stopTicks = int(math.round(stopDistance / syminfo.mintick))
    qty = (10000.0 * kellyPct) / stopDistance
    if newLong
        if strategy.position_size < 0
            strategy.cancel("Short SL")
        strategy.entry("Long", strategy.long, qty=qty, comment="Supertrend+RSI50")
        strategy.exit("Long SL", from_entry="Long", loss=stopTicks, comment_loss="Stop loss")
    if newShort
        if strategy.position_size > 0
            strategy.cancel("Long SL")
        strategy.entry("Short", strategy.short, qty=qty, comment="Supertrend+RSI50")
        strategy.exit("Short SL", from_entry="Short", loss=stopTicks, comment_loss="Stop loss")


plot(stDirection > 0 ? finalLower : stDirection < 0 ? finalUpper : na, "Python Supertrend", color=stDirection > 0 ? color.green : color.red)
plot(rsi14, "Python RSI14", color=color.blue, display=display.data_window)
