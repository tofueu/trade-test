//@version=6
// Rank 3 Python port: Supertrend10_3, signal exit without fixed TP, full Kelly.
// Python source: five_year_multi_market_kelly.py (indicators, make_signals, market_backtest).
// Binance SOLUSDT daily; Python UTC window [2021-10-10, 2026-10-10), warm-up 2021-07-01.
strategy("R03 | SOLUSDT | Supertrend10_3 | signal exit | full Kelly",
     overlay=true, initial_capital=10000, currency=currency.USD,
     commission_type=strategy.commission.percent, commission_value=0.05,
     slippage=0, margin_long=1, margin_short=1, pyramiding=0,
     process_orders_on_close=false, calc_on_order_fills=false,
     default_qty_type=strategy.fixed, default_qty_value=1)

startTime = input.time(timestamp("10 Oct 2021 00:00 +0000"), "Test start (UTC)")
warmTime = timestamp("01 Jul 2021 00:00 +0000")
kellyPct = input.float(24.543982453165512, "IS Kelly risk % of initial capital", step=0.000001) / 100.0
atrMult = input.float(1.5, "Initial stop ATR multiple", step=0.1)

f_ewm(float src, float alpha, bool reset) =>
    var float value = na
    if reset
        value := src
    else if not na(src)
        value := na(value) ? src : alpha * src + (1.0 - alpha) * value
    value

// Binance daily bars include the exact UTC warm-up timestamp used by Python.
warmReset = time == warmTime
trValue = warmReset ? high - low : ta.tr(true)
atr14Raw = f_ewm(trValue, 1.0 / 14.0, warmReset)
atr10Raw = f_ewm(trValue, 0.1, warmReset)
var int atr14Bars = 0
var int atr10Bars = 0
if warmReset
    atr14Bars := 1
    atr10Bars := 1
else if time > warmTime
    atr14Bars += 1
    atr10Bars += 1
atr14 = atr14Bars >= 14 ? atr14Raw : na
atr10 = atr10Bars >= 10 ? atr10Raw : na

// Same ATR10 Supertrend band recursion and direction as Python indicators().
basicUpper = (high + low) / 2.0 + 3.0 * atr10
basicLower = (high + low) / 2.0 - 3.0 * atr10
var float finalUpper = na
var float finalLower = na
var int stDirection = 0
if not na(atr10)
    if na(finalUpper[1])
        finalUpper := basicUpper
        finalLower := basicLower
        stDirection := 1
    else
        finalUpper := (basicUpper < finalUpper[1] or close[1] > finalUpper[1]) ? basicUpper : finalUpper[1]
        finalLower := (basicLower > finalLower[1] or close[1] < finalLower[1]) ? basicLower : finalLower[1]
        prevDirection = nz(stDirection[1], 1)
        stDirection := prevDirection < 0 and close > finalUpper ? 1 : prevDirection > 0 and close < finalLower ? -1 : prevDirection

// Python make_signals() opens only on a direction flip and carries that side.
var int signalState = 0
if stDirection > 0 and nz(stDirection[1], 0) <= 0
    signalState := 1
else if stDirection < 0 and nz(stDirection[1], 0) >= 0
    signalState := -1
previousSignalState = nz(signalState[1], 0)
startTransition = time >= startTime and time[1] < startTime
inWindow = time >= startTime
newLong = signalState == 1 and (previousSignalState != 1 or startTransition)
newShort = signalState == -1 and (previousSignalState != -1 or startTransition)

// Python uses the prior completed daily signal at this bar's open for exits,
// then opens the new position at this bar's open using prior-bar ATR14.
if inWindow and barstate.isconfirmed
    if strategy.position_size > 0 and signalState != 1
        strategy.close("Long", comment="Signal exit")
    if strategy.position_size < 0 and signalState != -1
        strategy.close("Short", comment="Signal exit")

if inWindow and barstate.isconfirmed and not na(atr14) and atr14 > 0
    stopDistance = atrMult * atr14
    stopTicks = int(math.max(1, math.round(stopDistance / syminfo.mintick)))
    qty = (10000.0 * kellyPct) / stopDistance
    if newLong
        if strategy.position_size < 0
            strategy.cancel("Short SL")
        strategy.entry("Long", strategy.long, qty=qty, comment="Supertrend10_3")
        strategy.exit("Long SL", from_entry="Long", loss=stopTicks, comment_loss="Stop loss")
    if newShort
        if strategy.position_size > 0
            strategy.cancel("Long SL")
        strategy.entry("Short", strategy.short, qty=qty, comment="Supertrend10_3")
        strategy.exit("Short SL", from_entry="Short", loss=stopTicks, comment_loss="Stop loss")


plot(stDirection > 0 ? finalLower : stDirection < 0 ? finalUpper : na, "Python Supertrend10_3", color=stDirection > 0 ? color.green : color.red)
