//@version=6
// Rank 1 exact-rule port: Python `five_year_exit_method_sweep.py`.
// Market/data mapping: Binance USD-M XRPUSDT daily -> BINANCE:XRPUSDT.P, 1D.
// Python range: 2021-10-10 <= bar time < 2026-10-10 UTC; warm-up starts 2021-07-01.
// Execution: completed-bar MACD signal, next-bar open order; initial stop = 1.5 x Python EWM ATR(14).
// Python used a 5 bp fee and 5 bp adverse slippage per side. TradingView supports the
// 5 bp commission exactly; its built-in slippage is ticks, not price-relative BPS.
// Here TradingView slippage is 0 ticks; Python's 5 bp adverse slippage remains a known
// cost difference. The script recreates Python's adjust=False EWM initialization at WARM.
strategy("R01 | XRPUSDT | MACD 12/26/9 signal exit | full Kelly",
     overlay=true,
     initial_capital=10000,
     currency=currency.USD,
     commission_type=strategy.commission.percent,
     commission_value=0.05,
     slippage=0,
     margin_long=1,
     margin_short=1,
     pyramiding=0,
     process_orders_on_close=false,
     calc_on_order_fills=false,
     default_qty_type=strategy.fixed,
     default_qty_value=1)

startTime = input.time(timestamp("10 Oct 2021 00:00 +0000"), "Test start (UTC)")
endTime   = input.time(timestamp("10 Oct 2026 00:00 +0000"), "Exclusive test end (UTC)")
warmTime  = timestamp("01 Jul 2021 00:00 +0000")
kellyPct  = input.float(20.067019278926047, "Full Kelly risk % of initial capital", step=0.000001) / 100.0
atrMult   = input.float(1.5, "Initial stop ATR multiple", step=0.1)

// Python uses ewm(adjust=False): seed with the first warm-up observation, then
// recursively apply alpha. Reset exactly at the source warm-up boundary.
f_ewm(float src, float alpha, bool reset) =>
    var float value = na
    if reset or na(value)
        value := src
    else
        value := alpha * src + (1.0 - alpha) * value
    value

warmReset = time == warmTime
ema12     = f_ewm(close, 2.0 / 13.0, warmReset)
ema26     = f_ewm(close, 2.0 / 27.0, warmReset)
macdLine  = ema12 - ema26
signalLine = f_ewm(macdLine, 2.0 / 10.0, warmReset)
trValue   = ta.tr(true)
atrRaw    = f_ewm(trValue, 1.0 / 14.0, warmReset)
var int warmBars = 0
if warmReset
    warmBars := 1
else if time > warmTime
    warmBars += 1
atr14 = warmBars >= 14 ? atrRaw : na
inWindow   = time >= startTime and time < endTime

longSignal  = ta.crossover(macdLine, signalLine)
shortSignal = ta.crossunder(macdLine, signalLine)
target      = longSignal ? 1 : shortSignal ? -1 : 0

// Python carries a position until a later opposite MACD crossover; it does not
// flatten merely because MACD returns to the other side of its signal line.
var float initialStop = na
var int sideAtEntry = 0

// A Python opposite signal exits at the next bar's open before checking that bar's
// intrabar stop. Cancel the existing stop when queuing that reversal, then arm the
// new position's stop in ticks with the entry order. This avoids fill recalculation.
if inWindow and barstate.isconfirmed and target != 0 and not na(atr14)
    stopDistance = atrMult * atr14
    qty = (10000.0 * kellyPct) / stopDistance
    if target == 1
        if strategy.position_size < 0
            strategy.cancel("Short SL")
        strategy.entry("Long", strategy.long, qty=qty, comment="MACD cross")
        strategy.exit("Long SL", from_entry="Long", loss=int(math.round(stopDistance / syminfo.mintick)), comment_loss="Stop loss")
    else
        if strategy.position_size > 0
            strategy.cancel("Long SL")
        strategy.entry("Short", strategy.short, qty=qty, comment="MACD cross")
        strategy.exit("Short SL", from_entry="Short", loss=int(math.round(stopDistance / syminfo.mintick)), comment_loss="Stop loss")

// Python force-closes its last open trade at the final available close. Pine cannot
// execute an order at a historical bar's close without changing its next-open model;
// this is deliberately reported as a known comparison difference.
if time < endTime and time_close >= endTime and strategy.position_size != 0
    strategy.close_all(comment="End of test window", immediately=true)

plot(strategy.position_size > 0 ? strategy.position_avg_price - atrMult * atr14[1] : strategy.position_size < 0 ? strategy.position_avg_price + atrMult * atr14[1] : na, "Initial SL", color=color.red, style=plot.style_linebr)
