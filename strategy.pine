//@version=6
strategy("RSI14_EMA200 - [SOLUSDT 30m]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.04)

ema50 = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
plot(ema50, color=color.orange, title="EMA 50")
plot(ema200, color=color.blue, title="EMA 200")

if ta.crossover(ema50, ema200)
    strategy.entry("Long", strategy.long)
if ta.crossunder(ema50, ema200)
    strategy.close("Long")
    strategy.entry("Short", strategy.short)
