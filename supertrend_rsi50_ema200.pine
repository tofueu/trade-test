// R02 experimental variant: original Supertrend+RSI50 plus EMA200 trend filter.
// Original R02 file is preserved unchanged.
//@version=6
strategy("R02 | SOLUSDT | Supertrend+RSI50+EMA200 | signal exit | full Kelly", overlay=true, initial_capital=10000, currency=currency.USD, commission_type=strategy.commission.percent, commission_value=0.05, slippage=0, margin_long=1, margin_short=1, pyramiding=0, process_orders_on_close=false, calc_on_order_fills=false, default_qty_type=strategy.fixed, default_qty_value=1)
startTime = input.time(timestamp("10 Oct 2021 00:00 +0000"), "Test start (UTC)")
endTime = input.time(timestamp("10 Oct 2026 00:00 +0000"), "Exclusive test end (UTC)")
warmTime = timestamp("01 Jul 2021 00:00 +0000")
limitTestEnd = input.bool(false, "Limit to test end (historical comparison)")
kellyPct = input.float(20.07779203610597, "IS Kelly risk % of initial capital", step=0.000001) / 100.0
atrMult = input.float(1.5, "Initial stop ATR multiple", step=0.1)
f_ewm(float src, float alpha, bool reset) =>
    var float value = na
    if reset
        value := src
    else if not na(src)
        value := na(value) ? src : alpha * src + (1.0 - alpha) * value
    value
warmReset = time == warmTime
trValue = warmReset ? high - low : ta.tr(true)
atr14Raw = f_ewm(trValue, 1.0 / 14.0, warmReset)
atr10Raw = f_ewm(trValue, 0.1, warmReset)
var int atr14Bars = 0
var int atr10Bars = 0
if warmReset
    atr14Bars := 1
    atr10Bars := 1
else if time > warmTime
    atr14Bars += 1
    atr10Bars += 1
atr14 = atr14Bars >= 14 ? atr14Raw : na
atr10 = atr10Bars >= 10 ? atr10Raw : na
delta = time > warmTime ? close - close[1] : na
gain = not na(delta) ? math.max(delta, 0.0) : na
loss = not na(delta) ? math.max(-delta, 0.0) : na
avgGain = f_ewm(gain, 1.0 / 14.0, warmReset)
avgLoss = f_ewm(loss, 1.0 / 14.0, warmReset)
var int rsiSamples = 0
if warmReset
    rsiSamples := 0
else if time > warmTime
    rsiSamples += 1
rsi14 = rsiSamples >= 14 ? (avgLoss == 0 ? (avgGain == 0 ? 50.0 : 100.0) : 100.0 - 100.0 / (1.0 + avgGain / avgLoss)) : na
basicUpper = (high + low) / 2.0 + 3.0 * atr10
basicLower = (high + low) / 2.0 - 3.0 * atr10
var float finalUpper = na
var float finalLower = na
var int stDirection = 0
if not na(atr10)
    if na(finalUpper[1])
        finalUpper := basicUpper
        finalLower := basicLower
        stDirection := 1
    else
        finalUpper := (basicUpper < finalUpper[1] or close[1] > finalUpper[1]) ? basicUpper : finalUpper[1]
        finalLower := (basicLower > finalLower[1] or close[1] < finalLower[1]) ? basicLower : finalLower[1]
        prevDirection = nz(stDirection[1], 1)
        stDirection := prevDirection < 0 and close > finalUpper ? 1 : prevDirection > 0 and close < finalLower ? -1 : prevDirection
ema200 = ta.ema(close, 200)
var int signalState = 0
if not na(rsi14) and stDirection != 0
    signalState := stDirection > 0 and rsi14 > 50 and close > ema200 ? 1 : stDirection < 0 and rsi14 < 50 and close < ema200 ? -1 : 0
// Receiver metadata only; strategy conditions, sizing and dates remain unchanged.
f_entry_meta(float distance) =>
    '{"kind":"entry","stop_distance":"' + str.tostring(distance, format.mintick) + '","take_profit":null}'
f_exit_meta(string kind) =>
    '{"kind":"' + kind + '","take_profit":null}'

previousSignalState = nz(signalState[1], 0)
startTransition = time >= startTime and time[1] < startTime
inWindow = time >= startTime and (not limitTestEnd or time < endTime)
newLong = signalState == 1 and (previousSignalState == 0 or startTransition)
newShort = signalState == -1 and (previousSignalState == 0 or startTransition)
if inWindow and barstate.isconfirmed
    if strategy.position_size > 0 and signalState != 1
        strategy.close("Long", comment="Signal exit", alert_message=f_exit_meta("signal_exit"))
    if strategy.position_size < 0 and signalState != -1
        strategy.close("Short", comment="Signal exit", alert_message=f_exit_meta("signal_exit"))
if inWindow and barstate.isconfirmed and not na(atr14) and atr14 > 0
    stopDistance = atrMult * atr14
    stopTicks = int(math.round(stopDistance / syminfo.mintick))
    qty = (10000.0 * kellyPct) / stopDistance
    if newLong
        if strategy.position_size < 0
            strategy.cancel("Short SL")
        strategy.entry("Long", strategy.long, qty=qty, comment="Supertrend+RSI50+EMA200", alert_message=f_entry_meta(stopTicks * syminfo.mintick))
        strategy.exit("Long SL", from_entry="Long", loss=stopTicks, comment_loss="Stop loss", alert_message=f_exit_meta("stop_exit"))
    if newShort
        if strategy.position_size > 0
            strategy.cancel("Long SL")
        strategy.entry("Short", strategy.short, qty=qty, comment="Supertrend+RSI50+EMA200", alert_message=f_entry_meta(stopTicks * syminfo.mintick))
        strategy.exit("Short SL", from_entry="Short", loss=stopTicks, comment_loss="Stop loss", alert_message=f_exit_meta("stop_exit"))
if limitTestEnd and time < endTime and time_close >= endTime and strategy.position_size != 0
    strategy.close_all(comment="End of test window", immediately=true, alert_message=f_exit_meta("window_exit"))
plot(stDirection > 0 ? finalLower : stDirection < 0 ? finalUpper : na, "Python Supertrend", color=stDirection > 0 ? color.green : color.red)
plot(ema200, "EMA200 filter", color=color.orange)
plot(rsi14, "Python RSI14", color=color.blue, display=display.data_window)
